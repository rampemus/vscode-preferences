#!/usr/bin/env bash
# Show 20 most recent branches with short relative ages, then git status.

git fetch >/dev/null 2>&1 &

echo "Most recent branches"

git branch --sort=committerdate \
  --format='%(committerdate:relative)%09%(HEAD) %(refname:short)' |
  tail -n 20 |
  awk -F'\t' '
    function shorten(d) {
      sub(/ seconds? /, "s ", d)
      sub(/ minutes? /, "min ", d)
      sub(/ hours? /, "h ", d)
      sub(/ days? /, "d ", d)
      sub(/ weeks? /, "w ", d)
      sub(/ months? /, "mo ", d)
      sub(/ years?,? /, "y ", d)
      return d
    }
    {
      age[NR] = shorten($1)
      name[NR] = $2
      if (length($2) > width) width = length($2)
    }
    END {
      for (i = 1; i <= NR; i++) {
        b = sprintf("%-" width "s", name[i])
        if (b ~ /^\*/) b = "\033[32m" b "\033[0m"
        printf "%s  \033[2m%s\033[0m\n", b, age[i]
      }
    }'

git status

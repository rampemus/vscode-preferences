# ~/Library/Application\ Support/com.mitchellh.ghostty/config
font-size = 17
font-feature = -calt
font-family = "Menlo Regular"
adjust-cell-height = 10%
confirm-close-surface = false
# window-subtitle = working-directory # use ghostty.zsh profile
macos-titlebar-style = tabs
shell-integration-features = no-title,no-cursor

# Regular vim cursor line color
palette = 4=#3b3f4c
cursor-style = block
mouse-hide-while-typing = true

working-directory = ~
window-new-tab-position = end

keybind = cmd+.=text:\x1b:CodeActionOpen\n
keybind = cmd+h=text:\x1b:BPrev\n
keybind = cmd+k=text:\x1b:CloseAllOtherBuffers\n
keybind = cmd+l=text:\x1b:BNext\n
keybind = cmd+m=text:\x1b:Telescope marks\n
keybind = cmd+p=text:\x1b:TelescopeFindFiles\n
keybind = cmd+s=text:\x1b:write\n
keybind = cmd+w=text:\x1b:SmartBD\n

keybind = cmd+shift+f=text:\x1b:TelescopeGrep\n\n
keybind = cmd+shift+g=text:\x1b:GitStatus\n
keybind = cmd+shift+h=text:\x1b:BufferLineMovePrev\n
keybind = cmd+shift+l=text:\x1b:BufferLineMoveNext\n
keybind = cmd+shift+p=text:\x1b:Telescope commands\n
keybind = cmd+shift+s=text:\x1b:wall\n

keybind = option+backspace=text:\x1b\x7f
